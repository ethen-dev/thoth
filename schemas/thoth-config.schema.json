{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thoth.local/schemas/thoth-config.schema.json",
  "title": "T.H.O.T.H. Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "wikiPath": { "type": "string", "minLength": 1 },
    "defaultType": { "type": "string", "minLength": 1 },
    "defaultStatus": { "type": "string", "minLength": 1 },
    "dateFormat": {
      "type": "string",
      "const": "YYYY-MM-DD"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "maxEntryBytes": { "type": "integer", "minimum": 256, "maximum": 1048576 },
        "maxStringLength": { "type": "integer", "minimum": 32, "maximum": 10000 },
        "redactKeys": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
