{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thoth.local/schemas/wiki-relation.schema.json",
  "title": "T.H.O.T.H. Wiki Relation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "relation"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "relation": {
      "type": "string",
      "enum": [
        "belongs_to",
        "mentions",
        "depends_on",
        "continues",
        "contradicts",
        "supports",
        "references",
        "related_to",
        "has_note",
        "has_decision",
        "has_implementation",
        "derived_from",
        "source_for",
        "supersedes",
        "applies_to",
        "updates",
        "complements",
        "refines",
        "extends",
        "follows",
        "implements",
        "fixes",
        "parallels",
        "verifies",
        "documents",
        "has_log",
        "has_subarea",
        "has_verification"
      ]
    }
  }
}
