{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thoth.local/schemas/wiki-index.schema.json",
  "title": "T.H.O.T.H. Derived Wiki Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["documents", "warnings"],
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "type", "status", "tags", "path"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "project",
              "note",
              "idea",
              "decision",
              "implementation",
              "session",
              "log",
              "research",
              "source",
              "entity",
              "character",
              "chapter",
              "timeline",
              "reference",
              "task"
            ]
          },
            "status": {
              "type": "string",
              "enum": ["draft", "active", "review", "accepted", "captured", "completed", "archived"]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
