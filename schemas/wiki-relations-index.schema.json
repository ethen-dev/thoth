{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thoth.local/schemas/wiki-relations-index.schema.json",
  "title": "T.H.O.T.H. Derived Wiki Relations Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["relations", "warnings"],
  "properties": {
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "relation"],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "belongs_to",
              "mentions",
              "depends_on",
              "continues",
              "contradicts",
              "supports",
              "references",
              "related_to",
              "has_note",
              "has_decision",
              "has_implementation",
              "derived_from",
              "source_for",
              "supersedes"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
