{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thoth.local/schemas/wiki-document.schema.json",
  "title": "T.H.O.T.H. Wiki Document Frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "type", "status"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "project",
        "note",
        "idea",
        "decision",
        "implementation",
        "session",
        "log",
        "research",
        "source",
        "entity",
        "character",
        "chapter",
        "timeline",
        "reference"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "string",
      "description": "Origin label. Source documents produced by source add use raw."
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "wiki-relation.schema.json"
      }
    }
  }
}
