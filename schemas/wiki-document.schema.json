{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thoth.local/schemas/wiki-document.schema.json",
  "title": "T.H.O.T.H. Wiki Document Frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "type", "status"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "project",
        "note",
        "idea",
        "decision",
        "implementation",
        "session",
        "log",
        "research",
        "source",
        "entity",
        "character",
        "chapter",
        "timeline",
        "reference",
        "task"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "review", "accepted", "captured", "completed", "archived"]
    },
    "created_at": {
      "type": "string",
      "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}|(?:\\d{2}/\\d{2}/\\d{4})|\\d{4}/\\d{2}/\\d{2})$",
      "description": "Supported formats: YYYY-MM-DD, DD/MM/YYYY, MM/DD/YYYY, YYYY/MM/DD."
    },
    "updated_at": {
      "type": "string",
      "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}|(?:\\d{2}/\\d{2}/\\d{4})|\\d{4}/\\d{2}/\\d{2})$",
      "description": "Supported formats: YYYY-MM-DD, DD/MM/YYYY, MM/DD/YYYY, YYYY/MM/DD."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "string",
      "description": "Origin label. Source documents produced by source add use raw."
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "wiki-relation.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["type"],
        "properties": {
          "type": {
            "const": "task"
          }
        }
      },
      "then": {
        "required": ["related"],
        "properties": {
          "related": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "type": "object",
              "properties": {
                "relation": {
                  "const": "belongs_to"
                }
              },
              "required": ["relation"]
            }
          }
        }
      }
    }
  ]
}
